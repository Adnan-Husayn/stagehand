# Copy to .env.local and fill in real values. Never commit real keys.
# If QLOO_API_KEY or LLM_API_KEY is missing, the app runs in DEMO MODE
# using labelled sample fixtures.

# Qloo hackathon key (sent as the X-Api-Key header).
QLOO_API_KEY=your-qloo-hackathon-key-here

# Hackathon base URL. Hackathon keys only work against this host.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Key for the model provider. The default provider is Google's Gemini API free tier.
# Create a key at https://aistudio.google.com/apikey (no card needed).
LLM_API_KEY=your-model-provider-key-here

# Optional. Base URL of any OpenAI-compatible Chat Completions API.
# Default: https://generativelanguage.googleapis.com/v1beta/openai
# Groq fallback: https://api.groq.com/openai/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional. Default: gemini-3.5-flash-lite. Groq fallback: openai/gpt-oss-120b
LLM_MODEL=gemini-3.5-flash-lite

# Optional. A number from 0 to 2. When unset, no temperature is sent and the provider default applies.
# Google advises leaving Gemini 3 at its default.
# LLM_TEMPERATURE=

# Optional. enabled or disabled. Sends DeepSeek's thinking switch. Leave unset for other providers.
# LLM_THINKING=

# DeepSeek (paid) instead of Gemini:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled

# Optional. Set to 1 to log the top-level and first-item key names of each fresh Qloo
# response on the server (never values, never the key). Use it on the first live run
# to confirm the real response shape. Leave unset otherwise.
DEBUG_QLOO=0
