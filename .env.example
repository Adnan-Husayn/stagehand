# Copy to .env.local and fill in real values. Never commit real keys.
# If QLOO_API_KEY or ANTHROPIC_API_KEY is missing, the app runs in DEMO MODE
# using labelled sample fixtures.

# Qloo hackathon key (sent as the X-Api-Key header).
QLOO_API_KEY=your-qloo-hackathon-key-here

# Hackathon base URL. Hackathon keys only work against this host.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Anthropic API key.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional model override. Default is claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Set to 1 to log the top-level and first-item key names of each fresh Qloo
# response on the server (never values, never the key). Use it on the first live run
# to confirm the real response shape. Leave unset otherwise.
DEBUG_QLOO=0
